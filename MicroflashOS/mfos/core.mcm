:: MicroflashOS Core Utilities [core.mcm]

:help
:: the cd commands are so the log messages don't get blown up with paths
set "curdir=%cd%"
cd /d "%pkgHelp%"
echo ---- help sections start here ----
echo.
for %%i in ("*.mhs") do (
    type "%%i"
	echo [help] INFO: load help section %%i from disk0p1 >>"%logfile%"
	echo.
)
cd /d "%pkgDir%\help"
for %%i in ("*.mhs") do (
    type "%%i"
	echo [help] INFO: load help section %%i from disk0p2 >>"%logfile%"
	echo.
)
cd /d "%curdir%"
echo ----- help sections end here -----
goto :eof

:about
echo MicroflashOS version: %mfosVer%
echo [about] INFO: mfos version is %mfosVer% >>"%logfile%"
echo Mounted system disk: %disk0Label%
echo [about] INFO: mounted system disk is %disk0Label% >>"%logfile%"
echo.
echo Hostname: %userdomain%
echo [about] INFO: hostname is %userdomain% >>"%logfile%"
echo Processor: %processor_identifier% (%NUMBER_OF_PROCESSORS% cores)
echo [about] INFO: processor is %processor_identifier% with %NUMBER_OF_PROCESSORS% cores >>"%logfile%"
echo Architecture: %processor_architecture%
echo [about] INFO: architecture is %processor_architecture% >>"%logfile%"
echo.
echo Made by Kenneth White.
goto :eof

:reboot
set "enforcereboot=true"
goto :eof

:writerecheck
call :checkWritable "%CD%" "%excludeWriteCheck%" 0
if ERRORLEVEL 10 (
	echo WARNING: Current directory contains read-only directories!
	echo [chkwrite] WARN: Current directory "%CD%" contains read-only directories >>"%logfile%"
	if exist "%toggles%\noReadOnly" (cmd /k exit)
	
	echo WARNING: You are in read-only mode.
    echo [chkwrite] WARN: Read-only mode enabled >>"%logfile%"
    set "dirWritable=nope"
	goto :eof
)
echo You are in normal mode. Write access enabled.
echo [chkwrite] INFO: running in normal mode - write access enabled >>"%logfile%"
set "dirWritable=yessir"
goto :eof

:shutdown
title Shutting down...
echo Shutting down...
echo [kernel] INFO: intercepted shutdown request >>"%logfile%"
exit

:clock
echo Time: %time%
echo Date: %date%
echo [clock] INFO: fetched time is %time% and date is %date% >>"%logfile%"
goto :eof

:print
if exist "%1" (
	type "%1"
	echo [print] INFO: printing contents of file "%1" >>"%logfile%"
	goto :eof
)
echo [print] INFO: user input: "%*" >>""%logfile%"
echo %*
goto :eof

:clear
if not exist "%toggles%\noclear" (
    cls
    echo [cmd] INFO: cleared shell output >>"%logfile%"
)
goto :eof
