:: MicroflashOS Developer Tools [devtools.mfm]

:mountsys
title MicroflashOS System Partition Mounter
if not exist "%disk0p1%\" (
    echo System partition not found!
    echo [mountsys] ERROR: system partition not found >>"%logfile%"
    goto :eof
)
echo Mounting disk0p1...
echo.
cd /d "%disk0p1%\"
echo [mountsys] INFO: mounted system partition >>"%logfile%"
echo The system partition has been made accessible to the current user.
echo.
echo Modifying the system partition directly may break your device.
echo Use with caution!
goto :eof

:modules
echo [modules] INFO: listing installed modules... >>"%logfile%"
echo Core modules:
echo.
dir /a:-d /b "%disk0p1%\"
echo.
echo User modules:
echo.
dir /a:-d /b "%userMods%\"
goto :eof

:toggles
for %%A in (create delete enabled list) do (
    if /I "%~1"=="%%A" (
        call :toggles_%%~A "%~2" & goto :eof
    )
)
if not "%~2"=="" (
    echo Invalid arguments!
    echo [toggle-manager] ERROR: invalid arguments >>"%logfile%"
    goto :eof
)
echo Manage your toggles.
echo.
echo Usage:
echo.
echo toggles [create/delete/enabled/list] [toggle]
echo [toggle-manager] ERROR: no option selected >>"%logfile%"
goto :eof

:toggles_create
if "%~1"=="" (
    echo Please enter a toggle name.
    echo [toggle-manager] ERROR: no toggle specified >>"%logfile%"
    goto :eof
)
if "%homeWritable%"=="nope" (
    echo Cannot create toggle while home directory is read-only!
    echo [toggle-manager] ERROR: cannot create toggle in read-only home directory >>"%logfile%"
    if exist "%toggles%\noReadOnly" (cmd /k exit)
    goto :eof
)
echo %~1>"%toggles%\%~1"
echo Toggle "%~1" written.
echo [toggle-manager] INFO: written toggle "%~1" >>"%logfile%"
goto :eof

:toggles_delete
if "%~1"=="" (
    echo Please enter a toggle name.
    echo [toggle-manager] ERROR: no toggle specified >>"%logfile%"
    goto :eof
)
if not exist "%toggles%\%~1" (
    echo Toggle "%~1" does not exist!
    echo [toggle-manager] ERROR: toggle "%~1" nonexistent >>"%logfile%"
    goto :eof
)
if "%homeWritable%"=="nope" (
    echo Cannot delete toggle while home directory is read-only!
    echo [toggle-manager] ERROR: cannot delete toggle in read-only home directory >>"%logfile%"
    if exist "%toggles%\noReadOnly" (cmd /k exit)
    goto :eof
)
del "%toggles%\%~1" /f /q
echo Toggle "%~1" deleted.
echo [toggle-manager] INFO: deleted toggle "%~1" >>"%logfile%"
goto :eof

:toggles_enabled
echo Enabled toggles:
echo [toggle-manager] INFO: listing enabled toggles... >>"%logfile%"
dir /b /s /a "%toggles%" | findstr .>nul || (
    echo There are no enabled toggles.
    echo [toggle-manager] INFO: no enabled toggles found >>"%logfile%"
    goto :eof
)
echo.
dir /a:-d /b "%toggles%"
goto :eof

:toggles_list
echo [toggle-manager] INFO: listing available toggles... >>"%logfile%"
type "%pkgHelp%\toggles.txt"
goto :eof

:getvars
echo.
set
goto :eof
